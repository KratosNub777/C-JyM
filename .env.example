DATABASE_URL=postgres://user:password@host.neon.tech:5432/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Clientes: independiente del acceso interno de Payload.
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE
BETTER_AUTH_URL=http://localhost:3000

# URL pública del sitio, usada para metadata/OG y el sitemap (solo server-side,
# por eso sin prefijo NEXT_PUBLIC_). Actualizar cuando se registre el dominio
# .com.py definitivo.
SITE_URL=http://localhost:3000

# Meilisearch self-hosted (ver docker-compose.yml para levantarlo en dev)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=YOUR_LOCAL_MASTER_KEY

# Reservas de pedidos impagos (solo servidor). El plazo queda guardado en cada pedido.
ORDER_RESERVATION_HOURS=24
# Generar un secreto aleatorio de al menos 32 caracteres; no reutilizar otros secretos.
CRON_SECRET=
# Worker local o servicio separado: npm run orders:worker
RESERVATION_POLL_SECONDS=60

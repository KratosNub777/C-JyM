DATABASE_URL=postgres://user:password@host.neon.tech:5432/dbname?sslmode=require
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Clientes: independiente del acceso interno de Payload.
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE
BETTER_AUTH_URL=http://localhost:3000
# Otros orígenes desde los que los clientes pueden iniciar sesión, separados por coma y con la URL
# exacta (sin comodines), p. ej. la variante con o sin www. Los previews de Vercel se agregan solos.
BETTER_AUTH_TRUSTED_ORIGINS=

# Envío de emails (códigos de verificación y recuperación de contraseña) por SMTP. Sirve con Gmail
# para probar (usar una contraseña de aplicación) y con Resend, SendGrid o el correo del dominio en
# producción. Sin SMTP_HOST, en desarrollo el email se imprime en la consola del servidor; en
# producción el envío falla, para no dejar a un cliente esperando un código que no salió.
# Para probar la configuración sin registrar usuarios: npm run email:test -- tu-correo@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Comercial José María <no-responder@tu-dominio.com.py>

# URL pública del sitio, usada para metadata/OG y el sitemap (solo server-side,
# por eso sin prefijo NEXT_PUBLIC_). Actualizar cuando se registre el dominio
# .com.py definitivo.
SITE_URL=http://localhost:3000

# Meilisearch self-hosted (ver docker-compose.yml para levantarlo en dev)
MEILISEARCH_HOST=http://localhost:7700
# En desarrollo es la clave maestra del docker-compose. En producción usar una clave acotada al
# índice `products` (npm run meilisearch:key) y no la maestra.
MEILISEARCH_API_KEY=YOUR_LOCAL_MASTER_KEY
# Solo para los scripts meilisearch:sync y meilisearch:key. Si falta, usan MEILISEARCH_API_KEY.
# No cargarla en el hosting de la app.
MEILISEARCH_MASTER_KEY=

# Reservas de pedidos impagos (solo servidor). El plazo queda guardado en cada pedido.
ORDER_RESERVATION_HOURS=24
# Generar un secreto aleatorio de al menos 32 caracteres; no reutilizar otros secretos.
CRON_SECRET=
# Worker local o servicio separado: npm run orders:worker
RESERVATION_POLL_SECONDS=60
